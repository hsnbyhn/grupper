# Grupper Monorepo - Git Ignore

# ============================================
# Gradle
# ============================================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting
.gradletasknamecache

# ============================================
# Kotlin
# ============================================
.kotlin/
*.kotlin_module
*.kotlin_metadata

# ============================================
# IntelliJ IDEA
# ============================================
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/
atlassian-ide-plugin.xml

# ============================================
# Android
# ============================================
*.apk
*.ap_
*.aab
*.dex
bin/
gen/
local.properties
captures/
.externalNativeBuild
.cxx
*.jks
*.keystore

# Android Studio
.navigation/

# ============================================
# iOS / Xcode
# ============================================
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/xcshareddata/WorkspaceSettings.xcsettings
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.moved-aside
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# CocoaPods
Pods/
*.podspec

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved

# ============================================
# MacOS
# ============================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ============================================
# Logs
# ============================================
*.log
logs/

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
*.swp
*.bak
*~

# ============================================
# Environment files (with sensitive data)
# ============================================
.env
.env.local
.env.*.local
secrets.properties
keystore.properties

# ============================================
# Test coverage
# ============================================
*.lcov
coverage/
htmlcov/

# ============================================
# Compose Multiplatform
# ============================================
composeApp/build/
**/generated/

# ============================================
# Backend specific
# ============================================
backend/build/
backend/out/

# ============================================
# Mobile specific
# ============================================
mobile/build/
mobile/composeApp/build/
mobile/iosApp/build/


